# Smart Money Trading Bot — Environment Variables
# Copy this to .env and fill in your values

# ── LLM Provider: "openai" (default) or "azure" ──
LLM_PROVIDER=openai

# ── Standard OpenAI (used when LLM_PROVIDER=openai) ──
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── Azure OpenAI / Azure AI Foundry (used when LLM_PROVIDER=azure) ──
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5-4          # your deployment name in Foundry
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ── MT5 HTTP REST API ──
MT5_BASE_URL=http://localhost:8001/api/v1

# ── Bot Mode ──
BOT_MODE=demo

# ── MT5 Credentials (for metatrader-http-server) ──
# MT5_LOGIN=your-login-here
# MT5_PASSWORD=your-password-here
# MT5_SERVER=your-server-here
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Start MT5 HTTP server:
# metatrader-http-server --login YOUR_LOGIN --password "YOUR_PASSWORD" --server YOUR_SERVER --host 0.0.0.0 --port 8001