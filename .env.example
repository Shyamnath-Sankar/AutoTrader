# Smart Money Trading Bot — Environment Variables
# Copy this to .env and fill in your values

# ── LLM (OpenAI-compatible API) ──
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ── MT5 HTTP REST API ──
MT5_BASE_URL=http://localhost:8001/api/v1

# ── Bot Mode ──
BOT_MODE=demo

# ── MT5 Credentials (for metatrader-http-server) ──
# MT5_LOGIN=your-login-here
# MT5_PASSWORD=your-password-here
# MT5_SERVER=your-server-here
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Start MT5 HTTP server:
# metatrader-http-server --login YOUR_LOGIN --password "YOUR_PASSWORD" --server YOUR_SERVER --host 0.0.0.0 --port 8001